+			lim_truncate_ppet(he_cap->ppet.ppe_threshold.ppe_th,
+					  WNI_CFG_HE_PPET_LEN);
+	} else {
+		he_cap->ppet.ppe_threshold.num_ppe_th = 0;
+	}
+	session->he_sta_obsspd = mac_ctx->mlme_cfg->he_caps.he_sta_obsspd;
