+QDF_STATUS csr_roam_set_psk_pmk(struct mac_context *mac, uint32_t sessionId,
+				uint8_t *psk_pmk, size_t pmk_len,
+				bool update_to_fw)
+{
+	struct csr_roam_session *pSession = CSR_GET_SESSION(mac, sessionId);
