+	qdf_mem_copy(mac->scan.countryCodeCurrent,
+		     mac->scan.countryCodeDefault, CFG_COUNTRY_CODE_LEN);
+	qdf_mem_copy(mac->scan.countryCodeElected,
+		     mac->scan.countryCodeDefault, CFG_COUNTRY_CODE_LEN);
