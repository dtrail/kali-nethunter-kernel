+QDF_STATUS wma_send_injection_frame_to_fw(tp_wma_handle wma_handle,
+					  struct inject_frame_req *req,
+					  uint8_t vdev_id);
+
+/**
+ * wma_handle_injection_fw_response() - Handle firmware response for injection
