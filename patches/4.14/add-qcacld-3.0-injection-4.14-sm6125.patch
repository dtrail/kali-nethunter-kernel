+ * FIFO processing with traffic coordination and resource management.
+ *
+ * Return: QDF_STATUS_SUCCESS on success, error code on failure
+ */
+QDF_STATUS wma_process_injection_queue(tp_wma_handle wma_handle);
+
+/**
