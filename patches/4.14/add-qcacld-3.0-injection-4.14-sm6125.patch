+	if (pGetSnrReq) {
+		if (QDF_STATUS_SUCCESS != wma_get_snr(pGetSnrReq)) {
+			sme_err("Error in wma_get_snr");
+			return;
+		}
+
+	} else
+		sme_err("pGetSnrReq is NULL");
+}
