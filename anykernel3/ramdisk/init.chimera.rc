# Chimera Familia Init Configuration

# Definiere den Service
# Wir rufen sh direkt auf, da wir im Ramdisk sind
service chimera_doom /system/bin/sh /chimera_controller.sh
    class main
    user root
    group root system
    disabled
    # Wichtig: "seclabel" sorgt dafür, dass wir nicht von SELinux blockiert werden.
    # u:r:su:s0 ist der Standard-Root-Kontext (funktioniert meist mit Magisk/KernelSU)
    # Falls ohne Root: u:r:kernel:s0 (kann aber restriktiv sein)
    seclabel u:r:su:s0

# Start-Trigger: Wenn Boot fertig ist
on property:sys.boot_completed=1
    start chimera_doom
